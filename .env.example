# AWS Credentials for S3 Bucket and Bedrock
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=ap-south-1
AWS_BEDROCK_REGION=ap-south-1
AWS_BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0
AWS_BEDROCK_GUARDRAIL_ID=your_bedrock_guardrail_id
AWS_BEDROCK_GUARDRAIL_VERSION=DRAFT
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_S3_REGION=ap-south-1
AWS_S3_IMAGES_PREFIX=images/
AWS_S3_METADATA_PREFIX=metadata/
AWS_S3_AI_BUCKET_NAME=your_ai_profile_bucket_name
AWS_S3_AI_IMAGES_PREFIX=images/
AWS_BEDROCK_KB_ID=your_bedrock_knowledge_base_id

# Optional production database password for hobby-ai-service
DB_PASSWORD=replace_with_a_strong_database_password

# AWS Lambda — image watermarking + business card Textract extraction
# Deploy lambdas/image-processor/ to AWS Lambda first
AWS_LAMBDA_IMAGE_PROCESSOR=bidmyhobby-image-processor

# Twilio — WhatsApp OTP login
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+14155238886
SITE_URL=http://localhost:8080

# SendGrid Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=your_sendgrid_verified_sender_email
